# Normalise line endings.
#
# Without this, Git on Windows converts LF to CRLF on checkout, and every
# file you have already committed shows as fully modified the next time
# someone clones the repo. That is the warning GitHub Desktop keeps
# showing on every file.
#
# LF everywhere in the repository; your editor and PHP do not care, and
# the diffs stay honest.

* text=auto eol=lf

# Explicit, so nothing gets guessed wrong.
*.php   text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.xml   text eol=lf

# The exception. cmd.exe requires CRLF in a batch file: with bare LF it
# eats the first character of the following line, so REM becomes M and
# a multi-line if( ) block stops parsing entirely. The rule above would
# hand every clone a broken script.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# And the opposite exception, which the deploy depends on. A shell script
# checked out with CRLF fails on the server with
#     /usr/bin/env: 'bash\r': No such file or directory
# because the carriage return becomes part of the interpreter's name. The
# rule at the top already gives LF, but this states it where someone editing
# a .sh on Windows will see it.
*.sh    text eol=lf

# Binary — never touch these.
*.webp  binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.svg   text eol=lf
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.zip   binary
*.docx  binary
*.pdf   binary
